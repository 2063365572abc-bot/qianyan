# Copy to .env. Never commit real secrets. Required values below are intentionally empty.
# APP_DOMAIN is a DNS hostname for production, with A/AAAA pointing at your VM.
# For local Compose use APP_DOMAIN=:8080 and the development override.
APP_ENV=development
APP_DOMAIN=:8080
APP_PUBLIC_URL=http://localhost:8080
POSTGRES_PASSWORD=
DATABASE_URL=postgresql+psycopg://qianyan:REPLACE_WITH_LOCAL_DB_PASSWORD@127.0.0.1:5432/qianyan
SESSION_SECRET=
OWNER_PASSWORD_HASH=

# Explicit provider selection; no automatic fallback or pretend live model.
AI_PROVIDER=nebius
# proposal forces the validated response function for providers that return prose in auto mode.
AI_TOOL_MODE=auto
ALIYUN_API_KEY=
ALIYUN_MODEL_ID=qwen-plus
ALIYUN_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
NEBIUS_API_KEY=
NEBIUS_MODEL_ID=nvidia/nemotron-3-super-120b-a12b
NEBIUS_BASE_URL=https://api.tokenfactory.nebius.com/v1
AI_MODE=live

# Optional read-only sources. Bind repo/project in the signed-in Settings page.
GITHUB_TOKEN=
VERCEL_TOKEN=

# Optional WeCom self-built application; all fields needed for real messaging.
NOTIFICATION_CHANNEL=in_app
WECOM_CORP_ID=
WECOM_AGENT_ID=
WECOM_APP_SECRET=
WECOM_USER_ID=
WECOM_CALLBACK_TOKEN=
WECOM_ENCODING_AES_KEY=
